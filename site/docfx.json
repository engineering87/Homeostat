{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [ "*/*.csproj" ],
          "exclude": [
            "Homeostat.Analyzers/**",
            "Homeostat.Cli/**",
            "Homeostat.Templates/**"
          ]
        }
      ],
      "dest": "api",
      "outputFormat": "apiPage",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages",
      "properties": { "Configuration": "Release" }
    }
  ],
  "build": {
    "content": [
      { "files": [ "index.md", "toc.yml" ] },
      { "files": [ "api/**/*.yml", "api/**/*.md" ] },
      {
        "src": "../docs",
        "files": [ "**/*.md", "toc.yml" ],
        "exclude": [ "nuget/**", "README.md" ],
        "dest": "docs"
      }
    ],
    "resource": [
      {
        "src": "../assets",
        "files": [ "*.png", "*.gif", "*.svg" ],
        "dest": "assets"
      }
    ],
    "output": "_site",
    "template": [ "default", "modern" ],
    "postProcessors": [ "ExtractSearchIndex" ],
    "globalMetadata": {
      "_appTitle": "Homeostat",
      "_appName": "Homeostat",
      "_appLogoPath": "assets/icon.png",
      "_appFaviconPath": "assets/icon.png",
      "_enableSearch": true,
      "_disableContribution": false,
      "_gitContribute": { "repo": "https://github.com/engineering87/Homeostat", "branch": "main" },
      "_appFooter": "Homeostat, self-healing for .NET applications. MIT licensed. Built with <a href=\"https://dotnet.github.io/docfx\">docfx</a>."
    },
    "sitemap": {
      "baseUrl": "https://engineering87.github.io/Homeostat",
      "changefreq": "weekly"
    }
  }
}
