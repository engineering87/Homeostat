<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Homeostat.Http</PackageId>
    <Description>HTTP for Homeostat: the failure ratio and latency of IHttpClientFactory clients as signals, in one line per client, and notifiers for webhooks, Slack, Microsoft Teams, PagerDuty and Opsgenie.</Description>
    <PackageTags>$(PackageTags);httpclient;httpclientfactory;webhook;slack;teams;pagerduty;opsgenie</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat\Homeostat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Homeostat.Http.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
