<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Homeostat.Data</PackageId>
    <Description>Database integration for Homeostat: connectivity and latency probes for any ADO.NET provider (SQL Server, PostgreSQL, MySQL, SQLite, Oracle), transient error tagging and connection pool reset actions.</Description>
    <PackageTags>$(PackageTags);database;ado-net;sqlclient;npgsql;connection-pool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat\Homeostat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
