<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableRequestDelegateGenerator>true</EnableRequestDelegateGenerator>
    <PackageId>Homeostat.AspNetCore</PackageId>
    <Description>ASP.NET Core endpoints for Homeostat: status and control endpoints, an embedded dashboard with one-click approvals, and alert ingestion from Prometheus Alertmanager, Grafana and Azure Monitor.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat\Homeostat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Dashboard\*" LogicalName="Homeostat.AspNetCore.Dashboard.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
