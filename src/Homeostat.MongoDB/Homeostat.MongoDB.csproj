<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Homeostat.MongoDB</PackageId>
    <Description>MongoDB for Homeostat: ping latency, primary availability, connection pool timeouts and replication lag as signals (MongoDB.Driver 3).</Description>
    <PackageTags>$(PackageTags);mongodb;database;replica-set;connection-pool</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat\Homeostat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MongoDB.Driver" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Homeostat.MongoDB.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
