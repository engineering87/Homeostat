<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Homeostat.RabbitMQ</PackageId>
    <Description>RabbitMQ for Homeostat: queue depth, consumers and dead letters as signals, and consumers that plans can pause and resume (RabbitMQ.Client 7).</Description>
    <PackageTags>$(PackageTags);rabbitmq;amqp;messaging;dead-letter</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat\Homeostat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
