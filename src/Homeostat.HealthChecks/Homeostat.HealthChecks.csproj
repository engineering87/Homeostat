<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>Homeostat.HealthChecks</PackageId>
    <Description>Health checks for Homeostat: ASP.NET Core and Microsoft.Extensions health check results become Homeostat signals, and Homeostat reports its own state (paused, budget, approvals, active conditions) as a health check.</Description>
    <PackageTags>$(PackageTags);aspnetcore;healthchecks</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat\Homeostat.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Homeostat.HealthChecks.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
