<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Homeostat.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>homeostat</ToolCommandName>
    <RootNamespace>Homeostat.Cli</RootNamespace>
    <Description>Command-line tool for Homeostat: read the status, coverage and condition history, pause and resume, approve or reject steps, flip switches and send test signals against a running application; replay recorded signals against a configuration offline.</Description>
    <PackageTags>$(PackageTags);cli;dotnet-tool</PackageTags>
    <!-- A tool is not a library: no public API to validate. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Homeostat.Testing\Homeostat.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\Homeostat.Cli.md" Pack="true" PackagePath="\README.md" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
