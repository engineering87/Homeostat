<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Homeostat.Cli</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>homeostat</ToolCommandName>
    <RootNamespace>Homeostat.Cli</RootNamespace>
    <Description>Command-line tool for Homeostat: read the status, pause and resume, approve or reject steps, flip switches and send test signals, against the endpoints of a running application.</Description>
    <PackageTags>$(PackageTags);cli;dotnet-tool</PackageTags>
    <!-- A tool is not a library: no public API to validate. -->
    <EnablePackageValidation>false</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Homeostat.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\docs\nuget\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
