<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- xUnit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <!-- Newer StackExchange.Redis versions mark the implicit string conversions as experimental. -->
    <!-- xUnit1051: the tests bound their own waits (simulated time, explicit timeouts), so passing the test context's
         token everywhere would add noise, not responsiveness. -->
    <NoWarn>$(NoWarn);StringToRedisValue;xUnit1051</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="FsCheck" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-off" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Homeostat\Homeostat.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Analyzers\Homeostat.Analyzers.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Aspire.Hosting\Homeostat.Aspire.Hosting.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Artemis\Homeostat.Artemis.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Kafka\Homeostat.Kafka.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.MongoDB\Homeostat.MongoDB.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.RabbitMQ\Homeostat.RabbitMQ.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.ServiceBus\Homeostat.ServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.AspNetCore\Homeostat.AspNetCore.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Azure\Homeostat.Azure.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Caching\Homeostat.Caching.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Cli\Homeostat.Cli.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.FeatureManagement\Homeostat.FeatureManagement.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Grpc\Homeostat.Grpc.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.EntityFrameworkCore\Homeostat.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.OpenFeature\Homeostat.OpenFeature.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.HealthChecks\Homeostat.HealthChecks.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Http\Homeostat.Http.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Kubernetes\Homeostat.Kubernetes.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Polly\Homeostat.Polly.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Redis\Homeostat.Redis.csproj" />
    <ProjectReference Include="..\..\src\Homeostat.Testing\Homeostat.Testing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provides Microsoft.Extensions.* (configuration, DI, logging) and Kestrel for the endpoint tests. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
