<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Package metadata -->
  <PropertyGroup>
    <!--
      The version of the release, shared by every package; the release workflow sets it from the tag
      (-p:HomeostatVersion=1.2.0). Preview packages (HomeostatPreview in their project) get "-preview" on a stable
      version: see Directory.Build.targets and docs/versioning.md.
    -->
    <HomeostatVersion Condition="'$(HomeostatVersion)' == ''">1.0.0-rc.1</HomeostatVersion>
    <Version>$(HomeostatVersion)</Version>
    <Authors>Francesco Del Re</Authors>
    <Copyright>Copyright (c) 2026 Francesco Del Re</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/engineering87/Homeostat</PackageProjectUrl>
    <RepositoryUrl>https://github.com/engineering87/Homeostat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>self-healing;resilience;remediation;health-checks;autonomic;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!--
    Package validation runs on pack: it checks the package across target frameworks.
    After the first release, set PackageValidationBaselineVersion to the latest published version, so that
    breaking changes to the public API fail the build.
  -->
  <PropertyGroup>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion> -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Library code builds without warnings in CI; NuGet audit findings stay warnings so a new advisory does not break builds. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true' and $(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

</Project>
